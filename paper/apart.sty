% apart.sty -- LaTeX version of the "Apart Research hackathon submission template" (Google Docs / Word).
% Measurements are taken from the template's own document.xml and styles.xml:
%   US Letter, 1in margins; body Old Standard TT 11pt, line spacing 1.15;
%   section headings Old Standard TT bold 14pt, colour #434343, 10pt before, 1.5 line spacing;
%   sub-headings Old Standard TT bold 13pt, colour #666666, 10pt before, 4pt after;
%   title Old Standard TT bold 20pt between a 3pt rule and a 1pt rule;
%   info box Arial 12pt on #FFF2CC with a 1pt black border; links #1155CC, underlined.
% Compile with XeLaTeX or LuaLaTeX (fonts are bundled in ./fonts). pdfLaTeX also works if oldstandard is installed.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{apart}[2026/11/08 Apart Research hackathon submission template]

\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
\fi
% Fonts. XeLaTeX / LuaLaTeX (recommended): the fonts ship in ./fonts, so nothing needs installing.
%   Old Standard TT = the template's text font (SIL Open Font Licence).
%   Liberation Sans = same letter widths as Arial, used only in the info box (SIL Open Font Licence).
% pdfLaTeX: uses the TeX packages oldstandard and tgheros if the system has them.
\ifPDFTeX
  \IfFileExists{oldstandard.sty}{\RequirePackage{oldstandard}}
    {\PackageWarning{apart}{oldstandard.sty not found: using the default font. Compile with XeLaTeX for the exact look}}
  \IfFileExists{tgheros.sty}{\RequirePackage{tgheros}\newcommand{\arialfamily}{\fontfamily{qhv}\selectfont}}
    {\newcommand{\arialfamily}{\sffamily}}
  \renewcommand{\familydefault}{\rmdefault}
\else
  \RequirePackage{fontspec}
  \setmainfont{OldStandard}[Path=fonts/, Extension=.ttf,
    UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic,
    BoldItalicFont=*-Bold, BoldItalicFeatures={FakeSlant=0.2}]
  \newfontfamily\arialfamily{LiberationSans}[Path=fonts/, Extension=.ttf,
    UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
\fi

\RequirePackage[table]{xcolor}
\RequirePackage[normalem]{ulem}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage[most]{tcolorbox}
\RequirePackage{array}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage[hidelinks]{hyperref}

\definecolor{apartheading}{HTML}{434343}
\definecolor{apartsubheading}{HTML}{666666}
\definecolor{apartlink}{HTML}{1155CC}
\definecolor{apartinfo}{HTML}{FFF2CC}

% ---------- body text ----------
\linespread{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\newcommand{\blankline}{\par\vspace{\baselineskip}}   % an empty paragraph in the template
\newcommand{\link}[2]{\href{#1}{\textcolor{apartlink}{\uline{#2}}}}

% ---------- headings ----------
\setcounter{secnumdepth}{1}
\titleformat{\section}{\normalfont\fontsize{14}{21}\selectfont\bfseries\color{apartheading}}{\thesection.}{0.3em}{}
\titlespacing*{\section}{0pt}{10pt}{0pt}
\titleformat{\subsection}{\normalfont\fontsize{13}{18}\selectfont\bfseries\color{apartsubheading}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

% ---------- lists (number at 0.25in, text at 0.5in, as in the template) ----------
\setlist{nosep}
\setlist[enumerate,1]{label=\upshape\arabic*., leftmargin=0.5in, labelindent=0.25in, labelwidth=0.25in, labelsep=0pt, align=left}
\setlist[itemize,1]{label=\upshape-, leftmargin=0.5in, labelindent=0.25in, labelwidth=0.25in, labelsep=0pt, align=left}
\newlist{letters}{enumerate}{1}
\setlist[letters]{label=\upshape(\alph*), leftmargin=0.5in, labelindent=0.25in, labelwidth=0.25in, labelsep=0pt, align=left, nosep}
% the indented "Tips for figures and tables" list (left 0.92in, right 0.42in)
\newlist{tips}{itemize}{1}
\setlist[tips]{label=\upshape-, leftmargin=0.917in, rightmargin=0.417in, labelindent=0.667in, labelwidth=0.25in, labelsep=0pt, align=left, nosep}

% ---------- title block ----------
\renewcommand{\footnoterule}{\vspace*{-3pt}\noindent\rule{2in}{0.4pt}\vspace*{2.6pt}}
\renewcommand{\thefootnote}{\arabic{footnote}}
\let\apart@footnotetext\footnotetext
\renewcommand{\footnotesize}{\fontsize{10}{12}\selectfont}

% \apartTitle{Title}{footnote text}
\newcommand{\apartTitle}[2]{%
  \noindent\rule{\textwidth}{3pt}\par
  \vspace{18pt}%
  {\centering\linespread{1}\fontsize{20}{24}\selectfont\bfseries #1\footnote{\linespread{1}\selectfont #2}\par}%
  \vspace{18pt}%
  \noindent\rule{\textwidth}{1pt}\par
  \vspace{10pt}%
}
% authors: a 3-column grid, each column 0.48in wide, exactly as in the template
% (so long words break across lines just like in the Word/Google version).
% To make the columns wider, add e.g. \setlength{\apartauthorcol}{1.6in} before \begin{document}.
\newlength{\apartauthorcol}\setlength{\apartauthorcol}{0.48in}
\newcommand{\apartAuthor}[2]{\hspace{0pt}#1\newline\hspace{0pt}#2}
\newenvironment{apartAuthors}
  {\par\begingroup\centering\linespread{1}\selectfont\setlength{\tabcolsep}{0pt}%
   \hyphenpenalty=0 \exhyphenpenalty=0
   \begin{tabular}{*{3}{>{\centering\arraybackslash}p{\apartauthorcol}}}}
  {\end{tabular}\par\endgroup\vspace{10pt}}
\newcommand{\apartWith}[1]{{\centering\linespread{1}\selectfont\textbf{With}\\#1\par}\vspace{10pt}}
% abstract: heading 14pt bold centred, text italic, justified, indented about 1in each side
\newenvironment{apartAbstract}{%
  \vspace{2pt}{\centering\fontsize{14}{17}\selectfont\bfseries Abstract\par}\vspace{10pt}%
  \list{}{\leftmargin=0.99in\rightmargin=0.93in\topsep=0pt\parsep=0pt}\item\relax\linespread{1}\selectfont\itshape}%
  {\endlist}

% ---------- the yellow info box (Arial 12pt, 1pt black border, wider than the text block) ----------
\newtcolorbox{apartInfo}{colback=apartinfo, colframe=black, boxrule=1pt, sharp corners,
  left=5pt, right=5pt, top=0pt, bottom=5pt, grow to left by=0.27in, grow to right by=0.42in,
  height from=2.59in to \textheight,
  fontupper=\arialfamily\fontsize{12}{15.9}\selectfont, before upper={\setlength{\parskip}{0pt}}}
\newcommand{\infopara}{\par\vspace{18pt}}   % each info paragraph has 18pt before it (Heading 2 style)

\endinput
